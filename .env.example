# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Flask session signing key. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Option 1: a full SQLAlchemy database URI (takes precedence).
# Handy for local development with SQLite:
# DATABASE_URL=sqlite:///cms.db

# Option 2: individual MySQL settings.
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=your-database-name
MYSQL_CA_CERT=ca.pem
